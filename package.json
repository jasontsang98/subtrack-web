{
  "name": "subtrack-web",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:unit && npm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:unit": "node --test --experimental-strip-types tests/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 --experimental-strip-types tests/integration/*.test.ts"
  },
  "dependencies": {
    "next": "^16.2.11",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "^16.2.11",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module",
  "description": "A private-by-default, self-hosted subscription manager backed by PostgreSQL.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasontsang98/subtrack-web.git"
  },
  "bugs": {
    "url": "https://github.com/jasontsang98/subtrack-web/issues"
  },
  "homepage": "https://github.com/jasontsang98/subtrack-web#readme"
}
