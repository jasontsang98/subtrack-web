POSTGRES_PASSWORD=subtrack-local-only
DATABASE_URL=postgresql://subtrack:subtrack-local-only@db:5432/subtrack
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
MAILPIT_PORT=8025

# Required single-admin login. Generate AUTH_SECRET with: openssl rand -hex 32
AUTH_PASSWORD=replace-with-a-long-unique-password
AUTH_SECRET=replace-with-at-least-32-random-characters
# Set true only when Subtrack is served over HTTPS.
COOKIE_SECURE=false

# Automatic database backup schedule.
BACKUP_TIMEZONE=Australia/Sydney
BACKUP_HOUR=2
BACKUP_POLL_SECONDS=60

# Local email defaults. Replace these with your SMTP provider when deploying online.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Subtrack <subtrack@localhost>
